# Base de datos. Siempre la cadena con pooling de Neon.
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/clock?sslmode=require"

# Better Auth. El secreto se genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. El origen autorizado y el redirect salen de BETTER_AUTH_URL:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Acceso. Dominios de Google Workspace habilitados, separados por coma.
GOOGLE_WORKSPACE_DOMAINS="empresa.com"
# El correo que arranca el workspace en una base vacía y queda como su owner.
# Con el workspace creado, todos entran por invitación desde `/equipo`, también
# este correo.
WORKSPACE_OWNER_EMAIL="owner@empresa.com"

# Email transaccional. Sin estas dos no se envían invitaciones ni recordatorios.
RESEND_API_KEY=""
EMAIL_FROM="clock@empresa.com"

# Trabajos programados. Vercel manda este valor como Bearer en el cron diario.
CRON_SECRET=""

# Archivos. Lo da la integración de Vercel Blob.
BLOB_READ_WRITE_TOKEN=""
