{
  "name": "clock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:time-ar",
    "test:unit": "vitest run",
    "test:time-ar": "TZ=America/Argentina/Buenos_Aires vitest run src/server/time src/modules/report/period.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "better-auth generate --config src/server/auth.ts --output src/server/db/auth-schema.ts -y",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@date-fns/tz": "^1.5.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fontkit": "2.0.4",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "pdfkit": "0.20.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "resend": "^6.32.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "2.0.9",
    "@types/node": "^20",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Carga de horas y administración interna."
}
